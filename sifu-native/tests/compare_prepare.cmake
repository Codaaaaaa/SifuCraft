execute_process(COMMAND "${SIMD}" RESULT_VARIABLE simd_result OUTPUT_VARIABLE simd)
execute_process(COMMAND "${SCALAR}" RESULT_VARIABLE scalar_result OUTPUT_VARIABLE scalar)
if(NOT simd_result EQUAL 0 OR NOT scalar_result EQUAL 0)
    message(FATAL_ERROR "Prepare corpus failed: SIMD=${simd_result}, scalar=${scalar_result}")
endif()
if(NOT simd STREQUAL scalar)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/prepare-simd.txt" "${simd}")
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/prepare-scalar.txt" "${scalar}")
    message(FATAL_ERROR "Prepare counts or geometry hashes differ; see prepare-{simd,scalar}.txt")
endif()
message(STATUS "264 Prepare cases: SIMD/scalar counts and complete geometry hashes agree")
